<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= actorName %> - MovieWeb</title>
    <link rel="stylesheet" href="/css/theme-cyberpunk.css">
    <style>
        .actor-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: transparent;
            border: 2px solid var(--neon-green);
            border-radius: 25px;
            color: var(--neon-green);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .back-button:hover {
            background: var(--neon-green);
            color: var(--bg-dark);
            box-shadow: var(--shadow-green);
            transform: translateY(-2px);
        }

        .actor-header {
            text-align: center;
            padding: 40px 0;
            border-bottom: 2px solid var(--neon-pink);
            margin-bottom: 40px;
            position: relative;
        }

        .actor-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg,
            transparent,
            var(--neon-blue),
            var(--neon-pink),
            var(--neon-blue),
            transparent
            );
            animation: scanline 3s linear infinite;
        }

        .actor-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(45deg, var(--neon-pink), var(--neon-blue));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 2rem;
            box-shadow: var(--shadow-pink);
        }

        .actor-name {
            font-size: 3rem;
            font-weight: bold;
            background: linear-gradient(45deg, var(--neon-pink), var(--neon-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 0, 255, 0.5);
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .actor-role {
            font-size: 1.3rem;
            color: var(--neon-green);
            text-shadow: 0 0 10px var(--neon-green);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .movies-section {
            background: var(--bg-card);
            border: 1px solid var(--neon-blue);
            border-radius: var(--border-radius);
            padding: 30px;
            margin-bottom: 40px;
            position: relative;
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.2);
            backdrop-filter: blur(10px);
        }

        .movies-section::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(45deg, var(--neon-pink), var(--neon-blue), var(--neon-green));
            z-index: -1;
            animation: borderGlow 2s ease-in-out infinite alternate;
            border-radius: var(--border-radius);
        }

        .section-title {
            font-size: 2rem;
            color: var(--neon-pink);
            margin-bottom: 25px;
            text-align: center;
            text-shadow: 0 0 10px rgba(255, 0, 110, 0.5);
            border-bottom: 1px solid var(--neon-pink);
            padding-bottom: 10px;
        }

        .movies-count {
            color: var(--neon-blue);
            font-weight: bold;
        }

        .movies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .movie-card {
            background: var(--bg-card);
            border: 1px solid var(--neon-purple);
            border-radius: var(--border-radius);
            padding: 20px;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .movie-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(191, 0, 255, 0.1), transparent);
            transition: left 0.5s ease;
        }

        .movie-card:hover::before {
            left: 100%;
        }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-purple);
            border-color: var(--neon-blue);
        }

        .movie-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .movie-title {
            color: var(--neon-blue);
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 10px;
            text-shadow: 0 0 5px var(--neon-blue);
            line-height: 1.3;
        }

        .movie-year {
            color: var(--neon-green);
            font-size: 0.9rem;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .movie-overview {
            color: var(--text-secondary);
            font-size: 0.85rem;
            line-height: 1.4;
            margin: 0;
        }

        .no-movies {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
            background: var(--bg-card);
            border: 2px dashed var(--neon-pink);
            border-radius: var(--border-radius);
            font-size: 1.1rem;
        }

        .stats-bar {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .stat-item {
            background: rgba(0, 245, 255, 0.1);
            border: 1px solid var(--neon-blue);
            border-radius: var(--border-radius);
            padding: 15px 25px;
            text-align: center;
            min-width: 120px;
        }

        .stat-number {
            color: var(--neon-yellow);
            font-size: 1.8rem;
            font-weight: bold;
            text-shadow: 0 0 10px var(--neon-yellow);
            display: block;
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        @media (max-width: 768px) {
            .actor-name {
                font-size: 2rem;
            }

            .movies-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 15px;
            }

            .actor-icon {
                width: 60px;
                height: 60px;
                font-size: 1.5rem;
            }

            .stats-bar {
                flex-direction: column;
                align-items: center;
            }

            .stat-item {
                width: 100%;
                max-width: 200px;
            }
        }

        @media (max-width: 480px) {
            .actor-name {
                font-size: 1.8rem;
            }

            .movies-grid {
                grid-template-columns: 1fr;
            }

            .movie-card {
                padding: 15px;
            }

            .section-title {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
<!-- Botón de cambio de tema -->
<button id="theme-toggle" class="theme-toggle">
    <span id="theme-icon">🌙</span>
    <span id="theme-text">Modo Oscuro</span>
</button>

<!-- Efecto de partículas -->
<div class="particles" id="particles"></div>

<div class="actor-container">
    <a href="/" class="back-button">← Volver al inicio</a>

    <div class="actor-header">
        <div class="actor-icon"></div>
        <h1 class="actor-name"><%= actorName %></h1>
        <p class="actor-role">Actor / Actriz</p>
    </div>

    <!-- Estadísticas -->
    <div class="stats-bar">
        <div class="stat-item">
            <span class="stat-number"><%= movies.length %></span>
            <span class="stat-label">Películas</span>
        </div>
        <div class="stat-item">
            <span class="stat-number"><%= new Date().getFullYear() - (movies.length > 0 ? new Date(movies[movies.length-1].release_date).getFullYear() : new Date().getFullYear()) %></span>
            <span class="stat-label">Años Activo</span>
        </div>
        <div class="stat-item">
            <span class="stat-number"><%= Math.round(movies.length / Math.max(1, (new Date().getFullYear() - (movies.length > 0 ? new Date(movies[movies.length-1].release_date).getFullYear() : new Date().getFullYear()))) * 10) / 10 %></span>
            <span class="stat-label">Películas/Año</span>
        </div>
    </div>

    <div class="movies-section">
        <h2 class="section-title">
            🎬 FILMOGRAFÍA
            <span class="movies-count">(<%= movies.length %> películas)</span>
        </h2>

        <% if (movies.length === 0) { %>
            <div class="no-movies">
                <p>📽️ No se encontraron películas para este actor</p>
                <p style="margin-top: 10px; color: var(--neon-blue);">
                    La filmografía no está disponible en este momento
                </p>
            </div>
        <% } else { %>
            <div class="movies-grid">
                <% movies.forEach(movie => { %>
                    <div class="movie-card">
                        <a href="/pelicula/<%= movie.movie_id %>" class="movie-link">
                            <h3 class="movie-title"><%= movie.title %></h3>
                            <% if (movie.release_date) { %>
                                <p class="movie-year"> <%= new Date(movie.release_date).getFullYear() %></p>
                            <% } %>
                            <% if (movie.vote_average) { %>
                                <p class="movie-year"><%= movie.vote_average %>/10</p>
                            <% } %>
                            <% if (movie.overview) { %>
                                <p class="movie-overview"><%= movie.overview.substring(0, 100) %>...</p>
                            <% } %>
                            <% if (movie.character_name) { %>
                                <p class="movie-year" style="color: var(--neon-green); margin-top: 8px;">
                                    como <%= movie.character_name %>
                                </p>
                            <% } %>
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const themeText = document.getElementById('theme-text');


    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeButton(savedTheme);

    themeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateThemeButton(newTheme);
    });

    function updateThemeButton(theme) {
        if (theme === 'dark') {
            themeIcon.textContent = '🌙';
            themeText.textContent = 'Modo Oscuro';
        } else {
            themeIcon.textContent = '☀️';
            themeText.textContent = 'Modo Claro';
        }
    }


    function createParticles() {
        const particlesContainer = document.getElementById('particles');
        const particleCount = 30;

        for (let i = 0; i < particleCount; i++) {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.style.left = Math.random() * 100 + 'vw';
            particle.style.animationDelay = Math.random() * 20 + 's';
            particle.style.animationDuration = (15 + Math.random() * 15) + 's';
            particlesContainer.appendChild(particle);
        }
    }


    document.addEventListener('DOMContentLoaded', function() {
        createParticles();
    });
</script>
</body>
</html>