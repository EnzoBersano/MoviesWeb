<%- include('partials/header', {
title: 'Actores: ' + searchTerm + ' - MovieWeb'
}) %>

<div class="cyber-container">
    <a href="/" class="btn-cyber" style="text-decoration: none; display: inline-block; margin-bottom: 30px;">
        ← NUEVA BÚSQUEDA
    </a>

    <header class="cyber-header">
        <h1 class="main-title">ACTORES: "<%= searchTerm.toUpperCase() %>"</h1>
        <p class="subtitle"><%= pagination.totalItems %> resultados encontrados</p>
    </header>

    <!-- El resto del contenido se mantiene igual -->
    <% if (actors && actors.length > 0) { %>
        <div class="people-grid">
            <% actors.forEach(actor => { %>
                <a href="/actor/<%= actor.person_id %>" style="text-decoration: none;">
                    <div class="person-card">
                        <div class="person-icon">🎭</div>
                        <div class="person-name"><%= actor.person_name %></div>
                    </div>
                </a>
            <% }); %>
        </div>

        <!-- Paginación (se mantiene igual) -->
    <% } else { %>
        <section class="cyber-section">
            <div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
                <p style="font-size: 1.2rem;">No se encontraron actores con "<%= searchTerm %>"</p>
            </div>
        </section>
    <% } %>
</div>

<%- include('partials/footer') %>