<!-- AGREGAR AL FINAL DE TU pelicula.ejs EXISTENTE -->

<!-- Sección de Interacción del Usuario -->
<div class="user-interaction-section" style="margin-top: 40px; padding: 30px; background: #f8f9fa; border-radius: 10px;">
    <h3 style="margin-bottom: 25px; color: #2c3e50;">
        🎬 ¿Qué te pareció esta película?
    </h3>

    <!-- Selector de Usuario -->
    <div style="margin-bottom: 25px;">
        <label for="userId" style="display: block; margin-bottom: 10px; font-weight: bold;">
            Selecciona tu usuario:
        </label>
        <select id="userId" style="width: 100%; padding: 10px; border-radius: 5px; border: 2px solid #ddd;">
            <option value="">-- Selecciona un usuario --</option>
            <!-- Esto se debe llenar dinámicamente desde el servidor -->
        </select>
    </div>

    <div id="interactionForms" style="display: none;">
        <!-- Calificación -->
        <div class="interaction-card" style="background: white; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h4 style="margin-bottom: 15px;">⭐ Calificar película</h4>
            <div class="star-rating" style="font-size: 32px; margin-bottom: 15px;">
                <span class="star" data-rating="1">☆</span>
                <span class="star" data-rating="2">☆</span>
                <span class="star" data-rating="3">☆</span>
                <span class="star" data-rating="4">☆</span>
                <span class="star" data-rating="5">☆</span>
            </div>
            <button id="btnRate" class="btn-action" style="background: #f39c12; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
                Guardar Calificación
            </button>
        </div>

        <!-- Reseña -->
        <div class="interaction-card" style="background: white; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h4 style="margin-bottom: 15px;">✍️ Escribir reseña</h4>
            <textarea id="reviewText" rows="4" placeholder="Escribe tu opinión sobre la película..."
                      style="width: 100%; padding: 10px; border: 2px solid #ddd; border-radius: 5px; font-family: inherit; resize: vertical;"></textarea>
            <button id="btnReview" class="btn-action" style="background: #3498db; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; margin-top: 10px;">
                Publicar Reseña
            </button>
        </div>

        <!-- Favoritos -->
        <div class="interaction-card" style="background: white; padding: 20px; border-radius: 8px;">
            <button id="btnFavorite" class="btn-action" style="background: #e74c3c; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 16px;">
                ❤️ Agregar a Favoritos
            </button>
        </div>
    </div>

    <div id="messageBox" style="margin-top: 20px; padding: 15px; border-radius: 5px; display: none;"></div>
</div>

<script>
    // Variables globales
    const movieId = <%= movie.movie_id %>; // Asume que tienes la variable movie disponible
    let selectedUserId = null;
    let selectedRating = 0;

    // Referencias a elementos
    const userSelect = document.getElementById('userId');
    const interactionForms = document.getElementById('interactionForms');
    const stars = document.querySelectorAll('.star');
    const btnRate = document.getElementById('btnRate');
    const btnReview = document.getElementById('btnReview');
    const btnFavorite = document.getElementById('btnFavorite');
    const reviewText = document.getElementById('reviewText');
    const messageBox = document.getElementById('messageBox');

    // Cargar usuarios al iniciar
    loadUsers();

    async function loadUsers() {
        try {
            const response = await fetch('/api/users');
            const users = await response.json();

            users.forEach(user => {
                const option = document.createElement('option');
                option.value = user.user_id;
                option.textContent = user.user_name;
                userSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error cargando usuarios:', error);
        }
    }

    // Mostrar formularios cuando se selecciona un usuario
    userSelect.addEventListener('change', function() {
        selectedUserId = this.value;
        if (selectedUserId) {
            interactionForms.style.display = 'block';
            loadUserData();
        } else {
            interactionForms.style.display = 'none';
        }
    });

    // Sistema de estrellas
    stars.forEach(star => {
        star.addEventListener('mouseover', function() {
            const rating = parseInt(this.dataset.rating);
            highlightStars(rating);
        });

        star.addEventListener('click', function() {
            selectedRating = parseInt(this.dataset.rating);
            fillStars(selectedRating);
        });
    });

    document.querySelector('.star-rating').addEventListener('mouseleave', function() {
        fillStars(selectedRating);
    });

    function highlightStars(rating) {
        stars.forEach((star, index) => {
            star.textContent = index < rating ? '★' : '☆';
        });
    }

    function fillStars(rating) {
        stars.forEach((star, index) => {
            star.textContent = index < rating ? '★' : '☆';
        });
    }

    // Calificar película
    btnRate.addEventListener('click', async function() {
        if (!selectedUserId) {
            showMessage('Por favor selecciona un usuario', 'error');
            return;
        }

        if (selectedRating === 0) {
            showMessage('Por favor selecciona una calificación', 'error');
            return;
        }

        try {
            const response = await fetch(`/movies/${movieId}/rate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: selectedUserId, rating: selectedRating })
            });

            const data = await response.json();

            if (data.success) {
                showMessage('✅ Calificación guardada exitosamente', 'success');
            } else {
                showMessage('❌ ' + data.error, 'error');
            }
        } catch (error) {
            showMessage('❌ Error al guardar calificación', 'error');
            console.error(error);
        }
    });

    // Escribir reseña
    btnReview.addEventListener('click', async function() {
        if (!selectedUserId) {
            showMessage('Por favor selecciona un usuario', 'error');
            return;
        }

        const review = reviewText.value.trim();
        if (!review) {
            showMessage('Por favor escribe una reseña', 'error');
            return;
        }

        try {
            const response = await fetch(`/movies/${movieId}/review`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: selectedUserId, review: review })
            });

            const data = await response.json();

            if (data.success) {
                showMessage('✅ Reseña publicada exitosamente', 'success');
                reviewText.value = '';
            } else {
                showMessage('❌ ' + data.error, 'error');
            }
        } catch (error) {
            showMessage('❌ Error al publicar reseña', 'error');
            console.error(error);
        }
    });

    // Agregar/quitar de favoritos
    btnFavorite.addEventListener('click', async function() {
        if (!selectedUserId) {
            showMessage('Por favor selecciona un usuario', 'error');
            return;
        }

        try {
            const response = await fetch(`/movies/${movieId}/favorite`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: selectedUserId })
            });

            const data = await response.json();

            if (data.success) {
                showMessage('✅ ' + data.message, 'success');
                btnFavorite.textContent = data.isFavorite ? '💔 Quitar de Favoritos' : '❤️ Agregar a Favoritos';
                btnFavorite.style.background = data.isFavorite ? '#95a5a6' : '#e74c3c';
            } else {
                showMessage('❌ ' + data.error, 'error');
            }
        } catch (error) {
            showMessage('❌ Error al actualizar favoritos', 'error');
            console.error(error);
        }
    });

    // Cargar datos existentes del usuario
    async function loadUserData() {
        try {
            const response = await fetch(`/api/users/${selectedUserId}/movie/${movieId}`);
            const data = await response.json();

            if (data.rating) {
                selectedRating = data.rating;
                fillStars(selectedRating);
            }

            if (data.review) {
                reviewText.value = data.review;
            }

            if (data.is_favorite) {
                btnFavorite.textContent = '💔 Quitar de Favoritos';
                btnFavorite.style.background = '#95a5a6';
            }
        } catch (error) {
            console.error('Error cargando datos del usuario:', error);
        }
    }

    // Mostrar mensajes
    function showMessage(message, type) {
        messageBox.textContent = message;
        messageBox.style.display = 'block';
        messageBox.style.background = type === 'success' ? '#d4edda' : '#f8d7da';
        messageBox.style.color = type === 'success' ? '#155724' : '#721c24';
        messageBox.style.border = `1px solid ${type === 'success' ? '#c3e6cb' : '#f5c6cb'}`;

        setTimeout(() => {
            messageBox.style.display = 'none';
        }, 5000);
    }
</script>

<style>
    .star {
        cursor: pointer;
        transition: all 0.2s;
        margin: 0 2px;
    }

    .star:hover {
        transform: scale(1.2);
    }

    .btn-action:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        transition: all 0.2s;
    }

    .interaction-card {
        transition: all 0.3s;
    }

    .interaction-card:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>