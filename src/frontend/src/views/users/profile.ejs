<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.user_name %> - MovieWeb</title>
    <link rel="stylesheet" href="/css/theme-cyberpunk.css">
    <style>
        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        .home-link {
            margin-bottom: 20px;
        }
        .home-link a {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 10px 20px;
            background: var(--bg-card);
            border: 2px solid var(--neon-blue);
            border-radius: 25px;
            color: var(--neon-blue);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }
        .home-link a:hover {
            background: var(--neon-blue);
            color: var(--bg-dark);
        }
        .profile-header {
            background: var(--bg-card);
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            border: 2px solid var(--neon-purple);
        }
        .profile-info h1 {
            color: var(--neon-pink);
            margin-bottom: 10px;
        }
        .username {
            color: var(--neon-blue);
            font-weight: bold;
        }
        .email {
            color: var(--text-secondary);
        }
        .profile-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            cursor: pointer;
        }
        .btn-warning {
            background: var(--neon-yellow);
            color: var(--bg-dark);
        }
        .btn-secondary {
            background: var(--neon-blue);
            color: white;
        }
        .btn-danger {
            background: var(--neon-red);
            color: white;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-blue);
        }
        .user-movies-section {
            background: var(--bg-card);
            padding: 30px;
            border-radius: 12px;
            border: 2px solid var(--neon-green);
        }
        .movie-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            margin-bottom: 15px;
            background: var(--bg-soft);
            border-radius: 8px;
            border-left: 4px solid var(--neon-purple);
        }
        .movie-info h3 {
            margin-bottom: 10px;
        }
        .movie-info a {
            color: var(--neon-blue);
            text-decoration: none;
        }
        .movie-info a:hover {
            color: var(--neon-pink);
        }
        .no-movies {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
<div class="profile-container">
    <div class="home-link">
        <a href="/users">← Volver a usuarios</a>
    </div>

    <div class="profile-header">
        <div class="profile-info">
            <h1><%= user.user_name %></h1>
            <p class="username">@<%= user.user_username %></p>
            <p class="email"><%= user.user_email %></p>
        </div>

        <div class="profile-actions">
            <a href="/users/<%= user.user_id %>/edit" class="btn btn-warning">Editar Usuario</a>
            <a href="/activity/timeline/<%= user.user_id %>" class="btn btn-secondary">Ver Timeline</a>
            <form action="/users/<%= user.user_id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Eliminar usuario?')">Eliminar Usuario</button>
            </form>
        </div>
    </div>

    <div class="user-movies-section">
        <h2>Películas de <%= user.user_name %> (<%= movies.length %>)</h2>

        <% if (movies.length === 0) { %>
            <div class="no-movies">
                <p>Este usuario aún no ha agregado películas.</p>
            </div>
        <% } else { %>
            <div class="movies-list">
                <% movies.forEach(movie => { %>
                    <div class="movie-item">
                        <div class="movie-info">
                            <h3>
                                <a href="/pelicula/<%= movie.movie_id %>"><%= movie.title %></a>
                            </h3>
                            <% if (movie.release_date) { %>
                                <p class="movie-year"><%= new Date(movie.release_date).getFullYear() %></p>
                            <% } %>
                            <% if (movie.rating) { %>
                                <div class="user-rating">
                                    <span class="rating-value">⭐ <%= movie.rating %>/10</span>
                                </div>
                            <% } %>
                            <% if (movie.opinion) { %>
                                <div class="user-opinion">
                                    <p class="opinion-text"><%= movie.opinion %></p>
                                </div>
                            <% } %>
                        </div>
                        <div class="movie-actions">
                            <form action="/users/<%= user.user_id %>/movies/<%= movie.movie_id %>/remove" method="POST">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Eliminar película?')">Eliminar</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>
</body>
</html>