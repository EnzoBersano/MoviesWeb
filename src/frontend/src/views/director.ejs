<%- include('partials/header', {
title: directorName + ' - MovieWeb'
}) %>

<div class="cyber-container">
    <header class="cyber-header">
        <h1 class="main-title"><%= directorName.toUpperCase() %></h1>
        <p class="subtitle">Director/Directora - Filmografía</p>
    </header>

    <section class="cyber-section">
        <h2 class="section-title">FILMOGRAFÍA (<%= movies.length %> PELÍCULAS)</h2>

        <% if (movies.length === 0) { %>
            <div style="text-align: center; padding: 40px; color: var(--text-secondary);">
                <p>No se encontraron películas para este director.</p>
            </div>
        <% } else { %>
            <div class="movies-grid">
                <% movies.forEach(movie => { %>
                    <div class="movie-card">
                        <a href="/pelicula/<%= movie.movie_id %>" style="text-decoration: none;">
                            <% if (movie.poster_url) { %>
                                <img src="<%= movie.poster_url %>" alt="<%= movie.title %>" loading="lazy">
                            <% } else { %>
                                <div class="poster-placeholder">🎬</div>
                            <% } %>
                            <div class="movie-card-info">
                                <div class="movie-card-title"><%= movie.title %></div>
                                <% if (movie.release_date) { %>
                                    <div style="color: var(--neon-blue); font-size: 0.9rem; margin-top: 5px;">
                                        <%= new Date(movie.release_date).getFullYear() %>
                                    </div>
                                <% } %>
                                <% if (movie.overview) { %>
                                    <p style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 8px; line-height: 1.3;">
                                        <%= movie.overview.substring(0, 100) %>...
                                    </p>
                                <% } %>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </section>
</div>

<%- include('partials/footer') %>