<!-- src/frontend/src/views/search-movies.ejs - NUEVA VISTA -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados: <%= searchTerm %> - MovieWeb</title>
    <link rel="stylesheet" href="/css/theme-cyberpunk.css">
    <style>
        .container {
            max-width: 1800px;
            margin: 0 auto;
            padding: 40px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 50px;
            padding: 40px 20px;
            background: var(--bg-card);
            border-radius: var(--border-radius);
            border: 2px solid var(--neon-blue);
        }

        .search-term {
            color: var(--neon-pink);
            font-style: italic;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 30px;
            padding: 12px 24px;
            background: var(--bg-card);
            border: 2px solid var(--neon-blue);
            border-radius: 30px;
            color: var(--neon-blue);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .back-link:hover {
            background: var(--neon-blue);
            color: var(--bg-dark);
            box-shadow: var(--shadow-blue);
        }

        /* Reutilizar estilos de paginación del archivo anterior */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin: 50px 0;
            flex-wrap: wrap;
        }

        .pagination-btn {
            padding: 12px 20px;
            background: var(--bg-card);
            border: 2px solid var(--neon-purple);
            border-radius: 8px;
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            min-width: 50px;
            text-align: center;
        }

        .pagination-btn:hover:not(.disabled) {
            background: var(--neon-purple);
            box-shadow: var(--shadow-purple);
            transform: translateY(-2px);
        }

        .pagination-btn.active {
            background: linear-gradient(45deg, var(--neon-pink), var(--neon-purple));
            border-color: var(--neon-pink);
            box-shadow: var(--shadow-pink);
        }

        .pagination-btn.disabled {
            opacity: 0.4;
            cursor: not-allowed;
            border-color: var(--text-muted);
        }

        .pagination-info {
            padding: 12px 24px;
            color: var(--text-secondary);
            font-weight: 600;
        }
    </style>
</head>
<body>
<button id="theme-toggle" class="theme-toggle">
    <span id="theme-icon">🌙</span> Tema
</button>

<div class="container">
    <a href="/" class="back-link">← Nueva búsqueda</a>

    <div class="page-header">
        <h1 style="font-size: 2.5rem; color: var(--text-primary); margin-bottom: 15px;">
            Películas: <span class="search-term">"<%= searchTerm %>"</span>
        </h1>
        <p style="font-size: 1.2rem; color: var(--text-secondary);">
            <%= pagination.totalMovies %> resultados encontrados
        </p>
    </div>

    <% if (movies && movies.length > 0) { %>
        <div class="movies-grid">
            <% movies.forEach(movie => { %>
                <a href="/pelicula/<%= movie.movie_id %>" style="text-decoration: none;">
                    <div class="movie-card">
                        <img
                                src="<%= movie.poster_url %>"
                                alt="<%= movie.title %>"
                                loading="lazy"
                        >
                        <div class="movie-card-info">
                            <div class="movie-card-title"><%= movie.title %></div>
                            <% if (movie.release_date) { %>
                                <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 5px;">
                                    <%= new Date(movie.release_date).getFullYear() %>
                                </div>
                            <% } %>
                            <% if (movie.vote_average) { %>
                                <div class="movie-card-rating">
                                    ⭐ <%= movie.vote_average.toFixed(1) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </a>
            <% }); %>
        </div>

        <!-- Paginación -->
        <div class="pagination">
            <% if (pagination.currentPage > 1) { %>
                <a href="/search/movies?q=<%= encodeURIComponent(searchTerm) %>&page=1" class="pagination-btn">««</a>
            <% } else { %>
                <span class="pagination-btn disabled">««</span>
            <% } %>

            <% if (pagination.hasPrevPage) { %>
                <a href="/search/movies?q=<%= encodeURIComponent(searchTerm) %>&page=<%= pagination.currentPage - 1 %>" class="pagination-btn">‹ Anterior</a>
            <% } else { %>
                <span class="pagination-btn disabled">‹ Anterior</span>
            <% } %>

            <span class="pagination-info">
                    Página <%= pagination.currentPage %> de <%= pagination.totalPages %>
                </span>

            <% if (pagination.hasNextPage) { %>
                <a href="/search/movies?q=<%= encodeURIComponent(searchTerm) %>&page=<%= pagination.currentPage + 1 %>" class="pagination-btn">Siguiente ›</a>
            <% } else { %>
                <span class="pagination-btn disabled">Siguiente ›</span>
            <% } %>

            <% if (pagination.currentPage < pagination.totalPages) { %>
                <a href="/search/movies?q=<%= encodeURIComponent(searchTerm) %>&page=<%= pagination.totalPages %>" class="pagination-btn">»»</a>
            <% } else { %>
                <span class="pagination-btn disabled">»»</span>
            <% } %>
        </div>
    <% } else { %>
        <div style="text-align: center; padding: 100px 20px; color: var(--text-muted); font-size: 1.3rem;">
            <p>No se encontraron películas con "<%= searchTerm %>"</p>
        </div>
    <% } %>
</div>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const savedTheme = localStorage.getItem('theme') || 'dark';

    if (savedTheme === 'light') {
        document.body.classList.add('light-theme');
        themeIcon.textContent = '☀️';
    }

    themeToggle.addEventListener('click', () => {
        document.body.classList.toggle('light-theme');
        const isLight = document.body.classList.contains('light-theme');
        themeIcon.textContent = isLight ? '☀️' : '🌙';
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });
</script>
</body>
</html>