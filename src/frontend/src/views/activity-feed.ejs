<%- include('partials/header', {
title: 'Feed de Actividad - MovieWeb'
}) %>

<div class="cyber-container">
    <header class="cyber-header">
        <h1 class="main-title">FEED DE ACTIVIDAD</h1>
        <p class="subtitle">Actividad reciente de todos los usuarios</p>
        <a href="/" class="back-link">← Volver al inicio</a>
    </header>

    <% if (activities.length === 0) { %>
        <section class="cyber-section">
            <div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
                <h2 style="color: var(--neon-pink); margin-bottom: 20px;">📭 SIN ACTIVIDAD RECIENTE</h2>
                <p style="font-size: 1.1rem;">Aún no hay actividades registradas en el sistema.</p>
            </div>
        </section>
    <% } else { %>
        <div style="display: grid; gap: 20px;">
            <% activities.forEach(activity => { %>
                <section class="cyber-section">
                    <div style="display: flex; gap: 20px; align-items: flex-start;">
                        <!-- Icono de actividad -->
                        <div style="
                                width: 60px;
                                height: 60px;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 1.5rem;
                                flex-shrink: 0;
                        <% if (activity.type === 'RATED_MOVIE') { %>
                            background: linear-gradient(45deg, var(--neon-yellow), var(--neon-pink));
                        <% } else if (activity.type === 'WROTE_REVIEW') { %>
                            background: linear-gradient(45deg, var(--neon-blue), var(--neon-purple));
                        <% } else if (activity.type === 'ADDED_TO_FAVORITES') { %>
                            background: linear-gradient(45deg, var(--neon-red), var(--neon-pink));
                        <% } %>
                                ">
                            <% if (activity.type === 'RATED_MOVIE') { %>⭐<% } %>
                            <% if (activity.type === 'WROTE_REVIEW') { %>✍️<% } %>
                            <% if (activity.type === 'ADDED_TO_FAVORITES') { %>❤️<% } %>
                        </div>

                        <!-- Contenido de actividad -->
                        <div style="flex: 1;">
                            <div style="display: flex; justify-content: between; align-items: flex-start; margin-bottom: 10px;">
                                <div style="color: var(--neon-blue); font-weight: bold;">
                                    Usuario: <%= activity.userId %>
                                </div>
                                <div style="color: var(--text-muted); font-size: 0.9rem;">
                                    <%= new Date(activity.timestamp).toLocaleString('es-ES', {
                                        year: 'numeric',
                                        month: 'short',
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </div>
                            </div>

                            <div>
                                <h3 style="color: var(--text-primary); margin-bottom: 8px; font-size: 1.2rem;">
                                    <% if (activity.type === 'RATED_MOVIE') { %>CALIFICÓ UNA PELÍCULA<% } %>
                                    <% if (activity.type === 'WROTE_REVIEW') { %>ESCRIBIÓ UNA RESEÑA<% } %>
                                    <% if (activity.type === 'ADDED_TO_FAVORITES') { %>AÑADIÓ A FAVORITOS<% } %>
                                </h3>

                                <p style="color: var(--text-secondary); margin-bottom: 10px;">
                                    <span style="color: var(--neon-green); font-weight: bold;">
                                        "<%= activity.details.movieTitle %>"
                                    </span>
                                </p>

                                <% if (activity.type === 'RATED_MOVIE') { %>
                                    <div style="color: var(--neon-yellow); font-size: 1.3rem; margin-top: 5px;">
                                        <% for(let i = 0; i < activity.details.rating; i++) { %>★<% } %>
                                        <% for(let i = activity.details.rating; i < 5; i++) { %>☆<% } %>
                                        (<%= activity.details.rating %>/5)
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>