<%- include('partials/header', {
title: 'MovieWeb - Descubre Películas',
additionalStyles: ''
}) %>

<!-- Header -->
<header class="cyber-header">
    <h1 class="main-title">MOVIEWEB</h1>
    <p class="subtitle">Descubre películas, actores y directores en un estilo cyberpunk</p>
</header>

<!-- Buscador Principal -->
<section class="cyber-section">
    <form class="search-form" action="/buscar" method="GET" style="display: flex; gap: 10px; max-width: 600px; margin: 0 auto;">
        <input
                type="text"
                name="q"
                class="cyber-input"
                placeholder="Buscar películas, actores, directores..."
                required
                style="flex: 1;"
        >
        <button type="submit" class="btn-cyber">Buscar</button>
    </form>
</section>

<!-- Navegación Rápida -->
<div class="nav-grid">
    <a href="/users" class="nav-card">
        <span class="nav-icon"></span>
        <div class="nav-title">Ver Usuarios</div>
        <div class="nav-desc">Explora la comunidad de MovieWeb</div>
    </a>

    <a href="/activity/feed" class="nav-card">
        <span class="nav-icon"></span>
        <div class="nav-title">Feed Global</div>
        <div class="nav-desc">Actividad reciente de todos los usuarios</div>
    </a>

    <% if (currentUser) { %>
        <a href="/activity/timeline/<%= currentUser.user_id %>" class="nav-card">
            <span class="nav-icon"></span>
            <div class="nav-title">Mi Timeline</div>
            <div class="nav-desc">Tu actividad personal</div>
        </a>
    <% } else { %>
        <a href="/login" class="nav-card">
            <span class="nav-icon"></span>
            <div class="nav-title">Iniciar Sesión</div>
            <div class="nav-desc">Accede a tu cuenta</div>
        </a>
    <% } %>
</div>

<!-- Géneros de Películas -->
<% if (genres && genres.length > 0) { %>
    <section class="cyber-section">
        <h2 class="section-title">Explorar por Géneros</h2>
        <div class="genres-grid">
            <% genres.forEach(genre => { %>
                <a href="/genre/<%= genre.genre_id %>" class="genre-card">
                    <div class="genre-name"><%= genre.genre_name %></div>
                    <% if (genre.movie_count) { %>
                        <div style="font-size: 0.8rem; color: var(--neon-pink); margin-top: 5px;">
                            <%= genre.movie_count %> películas
                        </div>
                    <% } %>
                </a>
            <% }); %>
        </div>
    </section>
<% } %>

<!-- Información de Usuario -->
<% if (currentUser) { %>
    <section class="cyber-section">
        <h2 class="section-title">Bienvenido, <%= currentUser.user_name %></h2>
        <div style="text-align: center;">
            <p>Estás conectado como <strong class="glow-green">@<%= currentUser.user_username %></strong></p>
            <div style="margin-top: 15px;">
                <form action="/logout" method="POST" style="display: inline;">
                    <button type="submit" class="btn-cyber btn-cyber-danger">Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </section>
<% } else { %>
    <section class="cyber-section">
        <h2 class="section-title">Únete a la Comunidad</h2>
        <div style="text-align: center;">
            <p style="margin-bottom: 15px; color: var(--text-secondary);">Regístrate para guardar tus películas favoritas y escribir reseñas</p>
            <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                <a href="/register" class="btn-cyber">Registrarse</a>
                <a href="/login" class="btn-cyber btn-cyber-secondary">Iniciar Sesión</a>
            </div>
        </div>
    </section>
<% } %>

<!-- Footer -->
<footer class="cyber-footer">
    <p>MovieWeb © 2025 - Sistema de Gestión de Películas</p>
    <p style="margin-top: 10px; font-size: 0.9rem;">
        Desarrollado con Node.js, Express, PostgreSQL y MongoDB
    </p>
</footer>

<%- include('partials/footer') %>