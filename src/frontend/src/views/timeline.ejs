<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - MovieWeb</title>
    <link rel="stylesheet" href="/css/theme-cyberpunk.css">
    <style>
        .timeline-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: transparent;
            border: 2px solid var(--neon-green);
            border-radius: 25px;
            color: var(--neon-green);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .back-button:hover {
            background: var(--neon-green);
            color: var(--bg-dark);
            box-shadow: var(--shadow-green);
            transform: translateY(-2px);
        }

        .cyber-header {
            text-align: center;
            padding: 40px 0;
            border-bottom: 2px solid var(--neon-pink);
            margin-bottom: 40px;
            position: relative;
        }

        .cyber-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg,
            transparent,
            var(--neon-blue),
            var(--neon-pink),
            var(--neon-blue),
            transparent
            );
            animation: scanline 3s linear infinite;
        }

        .main-title {
            font-size: 3rem;
            font-weight: bold;
            background: linear-gradient(45deg, var(--neon-pink), var(--neon-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 0, 255, 0.5);
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .user-info {
            font-size: 1.2rem;
            color: var(--neon-blue);
            text-shadow: 0 0 10px var(--neon-blue);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 40px 0;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--neon-purple);
            padding: 25px;
            border-radius: var(--border-radius);
            text-align: center;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
            transition: var(--transition);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(45deg, var(--neon-pink), var(--neon-blue), var(--neon-green));
            z-index: -1;
            animation: borderGlow 2s ease-in-out infinite alternate;
            border-radius: var(--border-radius);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-purple);
        }

        .stat-number {
            font-size: 3rem;
            font-weight: bold;
            color: var(--neon-yellow);
            text-shadow: 0 0 10px var(--neon-yellow);
            margin-bottom: 10px;
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .timeline {
            margin-top: 40px;
        }

        .activity-item {
            background: var(--bg-card);
            border: 1px solid var(--neon-blue);
            border-radius: var(--border-radius);
            padding: 25px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
            transition: var(--transition);
            border-left: 4px solid transparent;
        }

        .activity-item:hover {
            transform: translateX(5px);
            box-shadow: var(--shadow-blue);
            border-left-color: var(--neon-blue);
        }

        .activity-item.rated {
            border-left-color: var(--neon-yellow);
        }

        .activity-item.reviewed {
            border-left-color: var(--neon-green);
        }

        .activity-item.favorited {
            border-left-color: var(--neon-pink);
        }

        .activity-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .activity-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .icon-rated {
            background: linear-gradient(45deg, var(--neon-yellow), #ff9800);
            box-shadow: 0 0 15px rgba(255, 234, 0, 0.5);
        }

        .icon-reviewed {
            background: linear-gradient(45deg, var(--neon-green), #00c853);
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.5);
        }

        .icon-favorited {
            background: linear-gradient(45deg, var(--neon-pink), #e91e63);
            box-shadow: 0 0 15px rgba(255, 0, 110, 0.5);
        }

        .activity-type {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--text-primary);
            margin: 0;
        }

        .activity-content {
            margin-left: 65px;
        }

        .movie-title {
            color: var(--neon-blue);
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 10px;
            text-shadow: 0 0 5px var(--neon-blue);
        }

        .rating-stars {
            color: var(--neon-yellow);
            font-size: 1.3rem;
            margin: 10px 0;
            text-shadow: 0 0 10px var(--neon-yellow);
        }

        .timestamp {
            color: var(--text-muted);
            font-size: 0.9rem;
            text-align: right;
            margin-top: 15px;
            border-top: 1px solid rgba(0, 245, 255, 0.2);
            padding-top: 10px;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: var(--bg-card);
            border: 2px solid var(--neon-pink);
            border-radius: var(--border-radius);
            color: var(--text-secondary);
        }

        .empty-state h2 {
            font-size: 2rem;
            color: var(--neon-pink);
            margin-bottom: 20px;
            text-shadow: 0 0 10px rgba(255, 0, 110, 0.5);
        }

        .empty-state p {
            font-size: 1.1rem;
            margin-bottom: 10px;
        }

        .empty-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.7;
        }

        @media (max-width: 768px) {
            .main-title {
                font-size: 2rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .activity-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .activity-content {
                margin-left: 0;
            }

            .stat-number {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .activity-item {
                padding: 20px;
            }

            .main-title {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>
<!-- Botón de cambio de tema -->
<button id="theme-toggle" class="theme-toggle">
    <span id="theme-icon">🌙</span>
    <span id="theme-text">Modo Oscuro</span>
</button>

<!-- Efecto de partículas -->
<div class="particles" id="particles"></div>

<div class="timeline-container">
    <a href="/users/<%= userId %>" class="back-button">
        ← Volver al perfil
    </a>

    <div class="cyber-header">
        <h1 class="main-title">📅 Timeline de Actividad</h1>
        <p class="user-info">Usuario: <strong class="glow-blue"><%= userId %></strong></p>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number"><%= stats.totalRatings %></div>
                <div class="stat-label">Calificaciones</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= stats.totalReviews %></div>
                <div class="stat-label">Reseñas</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= stats.totalFavorites %></div>
                <div class="stat-label">Favoritos</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= stats.totalActivities %></div>
                <div class="stat-label">Total Actividades</div>
            </div>
        </div>
    </div>

    <% if (activities.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <h2>Sin actividad reciente</h2>
            <p>Aún no hay actividades registradas para este usuario.</p>
            <p style="margin-top: 20px; color: var(--neon-blue);">
                ¡Comienza a calificar, reseñar y agregar favoritos!
            </p>
        </div>
    <% } else { %>
        <div class="timeline">
            <% activities.forEach(activity => { %>
                <div class="activity-item <%=
                    activity.type === 'RATED_MOVIE' ? 'rated' :
                            activity.type === 'WROTE_REVIEW' ? 'reviewed' :
                                    'favorited'
                %>">
                    <div class="activity-header">
                        <% if (activity.type === 'RATED_MOVIE') { %>
                            <div class="activity-icon icon-rated">⭐</div>
                            <h3 class="activity-type">Calificó una película</h3>
                        <% } else if (activity.type === 'WROTE_REVIEW') { %>
                            <div class="activity-icon icon-reviewed">✍️</div>
                            <h3 class="activity-type">Escribió una reseña</h3>
                        <% } else if (activity.type === 'ADDED_TO_FAVORITES') { %>
                            <div class="activity-icon icon-favorited">❤️</div>
                            <h3 class="activity-type">Añadió a favoritos</h3>
                        <% } %>
                    </div>

                    <div class="activity-content">
                        <div class="movie-title">
                            <%= activity.details.movieTitle %>
                        </div>

                        <% if (activity.type === 'RATED_MOVIE') { %>
                            <div class="rating-stars">
                                <% for(let i = 0; i < activity.details.rating; i++) { %>★<% } %>
                                <% for(let i = activity.details.rating; i < 5; i++) { %>☆<% } %>
                                <span style="margin-left: 10px; font-size: 1rem; color: var(--neon-yellow);">
                                        (<%= activity.details.rating %>/5)
                                    </span>
                            </div>
                        <% } %>

                        <div class="timestamp">
                            <%= new Date(activity.timestamp).toLocaleString('es-ES', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
    // Sistema de cambio de tema
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const themeText = document.getElementById('theme-text');

    // Cargar tema guardado
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeButton(savedTheme);

    themeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateThemeButton(newTheme);
    });

    function updateThemeButton(theme) {
        if (theme === 'dark') {
            themeIcon.textContent = '🌙';
            themeText.textContent = 'Modo Oscuro';
        } else {
            themeIcon.textContent = '☀️';
            themeText.textContent = 'Modo Claro';
        }
    }

    // Efecto de partículas
    function createParticles() {
        const particlesContainer = document.getElementById('particles');
        const particleCount = 30;

        for (let i = 0; i < particleCount; i++) {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.style.left = Math.random() * 100 + 'vw';
            particle.style.animationDelay = Math.random() * 20 + 's';
            particle.style.animationDuration = (15 + Math.random() * 15) + 's';
            particlesContainer.appendChild(particle);
        }
    }

    // Inicializar efectos
    document.addEventListener('DOMContentLoaded', function() {
        createParticles();
    });
</script>
</body>
</html>